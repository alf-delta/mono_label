{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.ts": { "maxDuration": 10 },
    "api/discover.ts": { "maxDuration": 210 },
    "api/research.ts": { "maxDuration": 210 },
    "api/label-concept.ts": { "maxDuration": 210 },
    "api/export.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
