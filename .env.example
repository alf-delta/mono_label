# Use the deterministic local fixture without making external API calls.
RESEARCH_PROVIDER=fixture

# For live web research, remove RESEARCH_PROVIDER and provide a server-only key.
# OPENAI_API_KEY=sk-...
# OPENAI_RESEARCH_MODEL=gpt-5.6-sol
# OPENAI_CREATIVE_MODEL=gpt-5.6-terra

# Required for a public OpenAI-backed deployment. Generate with: openssl rand -hex 32
# SAFETY_IDENTIFIER_SECRET=replace-with-a-random-server-only-secret

# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
# TRUST_PROXY=1

# Optional process-local limits. Each limit uses the same sliding window.
# API_RATE_LIMIT_WINDOW_MS=600000
# DISCOVERY_RATE_LIMIT_MAX=8
# RESEARCH_RATE_LIMIT_MAX=8
# CONCEPT_RATE_LIMIT_MAX=8
# EXPORT_RATE_LIMIT_MAX=12

# Production web server. HOST defaults to 0.0.0.0 in production.
# HOST=0.0.0.0
# PORT=5173

# Development API process. Vite proxies /api to this address.
API_HOST=127.0.0.1
API_PORT=5174
